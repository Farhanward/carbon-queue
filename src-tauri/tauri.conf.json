{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CarbonQueue",
  "version": "0.1.0",
  "identifier": "com.carbonflow.queue",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "CarbonQueue",
        "width": 1280,
        "height": 820,
        "minWidth": 1100,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "CarbonFlow",
    "copyright": "Copyright CarbonFlow",
    "category": "Business",
    "shortDescription": "CarbonQueue Windows clinic queue",
    "longDescription": "CarbonQueue manages clinic waiting tickets, queue display, and SMS-ready notifications.",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "perMachine",
        "displayLanguageSelector": true,
        "languages": [
          "Arabic",
          "English"
        ]
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ3MjhCNDczODBEMzFBMzUKUldSSEtMUnpnTk1hTlJzM2Y1ck04dTlTVlBRemduZVJ0YVhaMVRMakJJQys5Ykp2L2tlczN5QjMK",
      "endpoints": [
        "https://releases.carbonflows.store/update/carbonqueue/{{target}}/{{current_version}}"
      ]
    }
  }
}